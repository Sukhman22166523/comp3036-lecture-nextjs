{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./data": {
      "types": "./src/data.ts",
      "default": "./dist/data.js"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./dist/seed.js"
    },
    "./queries": {
      "types": "./src/queries.ts",
      "default": "./dist/queries.js"
    }
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@types/node": "^22.13.1",
    "vitest": "^3.0.7"
  }
}