generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  urlId       String   @unique
  title       String
  content     String
  description String
  imageUrl    String
  date        DateTime
  category    String
  views       Int      @default(0)
  active      Boolean  @default(true)

  tags  Tag[]  @relation("PostTags")
  Likes Like[]
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[] @relation("PostTags")
}

model Like {
  postId Int
  userIP String

  Post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userIP])
}